NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# NEXT_PUBLIC_SUPABASE_URL = Project URL de Supabase → Settings → API
# Formato correcto: https://abcdefghijk.supabase.co
# NO usar: https://....supabase.co/rest/v1  |  https://....vercel.app  |  barra final /
#
# NEXT_PUBLIC_SITE_URL = URL pública del sitio (sin barra final).
# En Supabase → Auth → URL Configuration, Site URL debe coincidir.
# Redirect URLs: https://tu-dominio.vercel.app/** y http://localhost:3000/**

# Service role (solo servidor / cron). Nunca exponer al browser.
# Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Secreto del cron de farmacias de turno (Vercel Cron → Authorization: Bearer …)
# Generá uno largo y aleatorio; mismo valor en Vercel → Environment Variables.
CRON_SECRET=

# Asistente Pilar (opcional). Sin esta key, Pilar igual responde con datos de la base.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
